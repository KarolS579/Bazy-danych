@* encoding: utf-8 *@
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BuildRent</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
            color: #ffc107 !important; /* Nawiązanie do kolorystyki budowlanej */
        }

        footer {
            margin-top: 50px;
            padding: 20px 0;
            border-top: 1px solid #dee2e6;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">BuildRent</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Equipment", "Home")">Sprzęt</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Warehouses", "Home")">Magazyny</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Customers", "Home")">Klienci</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Rentals", "Home")">Wynajem i Rezerwacje</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Services", "Home")">Serwis</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning">@User.Identity.Name</span>
                        </li>
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-warning px-3 ms-2" href="@Url.Action("Panel", "Home")">Panel Admina</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-warning text-white px-3 ms-2" href="@Url.Action("LogOff", "Account")">Wyloguj się</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-warning text-white px-3" href="@Url.Action("Login", "Account")">Zaloguj się</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()

        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year - Karol Szajewski [cite: 10]</p>
            <p>Akademia Nauk Stosowanych w Nowym Sączu - Bazy Danych [cite: 1, 6]</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
