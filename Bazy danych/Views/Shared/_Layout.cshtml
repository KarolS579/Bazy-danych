@* encoding: utf-8 *@
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BuildRent</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/Site.css" />

    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">BuildRent</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Equipment", "Equipment")">Sprzęt</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Warehouses", "Warehouse")">Magazyny</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Klienci")">Klienci</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Wynajmy")">Wynajem</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Serwis")">Serwis</a>
                        </li>
                    }
                    </ul>

                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link no-underline text-warning">@User.Identity.Name</span>
                        </li>
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-warning no-underline px-3 ms-2" href="@Url.Action("Panel", "Home")">Panel Admina</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-warning text-white no-underline px-3 ms-2" href="@Url.Action("LogOff", "Account")">Wyloguj się</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-warning text-white no-underline px-3" href="@Url.Action("Login", "Account")">Zaloguj się</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()

        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year - Karol Szajewski | Volodymyr Romanyak</p>
            <p>Akademia Nauk Stosowanych w Nowym Sączu - Bazy Danych</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
