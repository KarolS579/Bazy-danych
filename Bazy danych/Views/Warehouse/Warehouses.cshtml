@* encoding: utf-8 *@
@model IEnumerable<Bazy_danych.Models.Magazyn>

@{
    ViewBag.Title = "Magazyny";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Magazyny</h2>
        <a class="btn btn-info fw-bold" href="@Url.Action("AddWarehouse", "Warehouse")">+ Dodaj nowy magazyn</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nazwa Magazynu</th>
                            <th>Lokalizacja</th>
                            <th>Pojemność</th>
                            <th>Zajętość</th>
                            <th>Status</th>
                            <th>Data dodania</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var occupancy = item.Pojemnosc > 0 ? (int)Math.Round((item.ZajeteMiejsce * 100.0) / item.Pojemnosc) : 0;
                            var barClass = occupancy >= 90 ? "bg-danger" : (occupancy >= 70 ? "bg-warning" : "bg-success");
                            <tr>
                                <td>@item.Nazwa</td>
                                <td>@item.Lokalizacja</td>
                                <td>@item.Pojemnosc jednostek</td>
                                <td>
                                    <div class="progress position-relative" style="height: 25px;">
                                        <div class="progress-bar @barClass"
                                             role="progressbar"
                                             style="width: @occupancy%;"
                                             aria-valuenow="@occupancy"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                        <span class="position-absolute top-50 start-50 translate-middle fw-semibold"
                                              style="color:#212529; z-index:2; pointer-events:none;">
                                            @occupancy%
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Aktywny")
                                    {
                                        <span class="badge bg-success">Aktywny</span>
                                    }
                                    else if (item.Status == "Przepełniony")
                                    {
                                        <span class="badge bg-warning text-dark">Przepełniony</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Nieaktywny</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditWarehouse", "Warehouse", new { id = item.Id })">Edytuj</a>
                                    @using (Html.BeginForm("DeleteWarehouse", "Warehouse", FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno chcesz usunąć ten magazyn?');">Usuń</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Brak magazynów w bazie. Kliknij <strong>+ Dodaj nowy magazyn</strong>, aby dodać pierwszy wpis.
                </div>
            }
        </div>
    </div>
</div>

