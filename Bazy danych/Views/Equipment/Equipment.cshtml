@* encoding: utf-8 *@
@model IEnumerable<Bazy_danych.Models.Sprzet>

@{
    ViewBag.Title = "Zarządzanie Sprzętem";
}

@section scripts {
    <script>
    $(document).ready(function () {
        $('.btn-usun-sprzet').click(function (e) {
            e.preventDefault(); // Zatrzymanie przeładowania strony

            var sprzetId = $(this).data('id');
            var rowElement = $(this).closest('tr');

            // Komunikat Chrome z pytaniem przed usunięciem
            if (confirm("Czy na pewno chcesz spróbować usunąć ten sprzęt?")) {
                $.ajax({
                    url: '@Url.Action("DeleteJson", "Equipment")',
                    type: 'POST',
                    data: { id: sprzetId },
                    success: function (response) {
                        if (response.success) {
                            // Jeśli się udało (sprzęt nie był powiązany z żadnym wynajmem)
                            rowElement.fadeOut(500);
                        } else {
                            // Komunikat Chrome informujący o blokadzie w bazie danych
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert("Wystąpił nieoczekiwany błąd komunikacji z serwerem.");
                    }
                });
            }
        });
    });
    </script>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inwentarz Sprzętu</h2>
        <a class="my-custom-btn fw-bold" href="@Url.Action("AddEquipment", "Equipment")">+ Dodaj nowy sprzęt</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nazwa</th>
                            <th>Kategoria</th>
                            <th>Cena (PLN/doba)</th>
                            <th>Status</th>
                            <th>Data dodania</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nazwa</td>
                                <td>@item.Kategoria</td>
                                <td>@item.Cena_wynajmu.ToString("0.00")</td>
                                <td>
                                    @{
                                        // Czyszczenie tekstu z bazy: usuwanie spacij i zamiana na małe litery
                                        var statusOczyszczony = (item.Status ?? "").Trim().ToLower();
                                    }

                                    @if (statusOczyszczony == "dostępny" || statusOczyszczony == "dostepny")
                                    {
                                        <span class="badge bg-success">Dostępny</span>
                                    }
                                    else if (statusOczyszczony == "wynajęty" || statusOczyszczony == "wynajety")
                                    {
                                        <span class="badge bg-danger">Wynajęty</span>
                                    }
                                    else if (statusOczyszczony == "serwis")
                                    {
                                        <span class="badge bg-info text-dark">Serwis</span>
                                    }
                                    else if (statusOczyszczony == "archiwalny")
                                    {
                                        <span class="badge bg-secondary">Archiwalny</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">@statusOczyszczony</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditEquipment", "Equipment", new { id = item.Id })">Edytuj</a>
                                    @using (Html.BeginForm("DeleteEquipment", "Equipment", FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="button" class="btn btn-sm btn-usun-sprzet btn-outline-danger" data-id="@item.Id">Usuń</button>                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Brak sprzętu w bazie. Kliknij <strong>+ Dodaj nowy sprzęt</strong>, aby dodać pierwszy wpis.
                </div>
            }
        </div>
    </div>
</div>