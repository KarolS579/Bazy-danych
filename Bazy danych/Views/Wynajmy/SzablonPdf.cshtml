@model Bazy_danych.Models.Wynajem

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Potwierdzenie Wynajmu</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            color: #000;
            line-height: 1.4;
            font-size: 14px;
        }

        .title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            text-transform: uppercase;
            border-bottom: 1px solid #000;
            padding-bottom: 5px;
        }

        .section {
            margin-bottom: 15px;
        }

        .bold {
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="title">Potwierdzenie Wynajmu nr #@Model.Id</div>

    <div class="section">
        <span class="bold">Dane Klienta:</span><br />
        Imię i nazwisko: @Model.Klient.Imie @Model.Klient.Nazwisko
    </div>

    <div class="section">
        <span class="bold">Wynajęty sprzęt:</span><br />
        Nazwa: @Model.Sprzets.Nazwa<br />
        Numer seryjny: @Model.Sprzets.NumerSeryjny<br />
        Cena za dobę: @Model.Sprzets.Cena_wynajmu zł
    </div>

    <div class="section">
        <span class="bold">Okres wynajmu:</span><br />
        Data rozpoczęcia: @Model.DataWynajmu.ToShortDateString()<br />
        Data zakończenia: @(Model.DataZwrotu.HasValue ? Model.DataZwrotu.Value.ToShortDateString() : "W trakcie")<br />
        Czas trwania: @ViewBag.LiczbaDni dni
    </div>

    <div class="section" style="margin-top: 30px; font-size: 16px;">
        <span class="bold">ŁĄCZNY KOSZT: @ViewBag.LacznaCena,00 zł</span>
    </div>

</body>
</html>