@model IEnumerable<Bazy_danych.Models.Wynajem>

@{
    ViewBag.Title = "Lista Wynajmów";
}

<h2>Panel Wynajmów</h2>

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">

    <div>
        @Html.ActionLink("Dodaj nowy wynajem", "Create", null, new { @class = "my-custom-btn fw-bold" })
    </div>

    <div class="d-flex align-items-center gap-2">
        @Html.ActionLink("Zobacz Archiwum", "Archiwum", null, new { @class = "my-custom-btn fw-bold" })

        @using (Html.BeginForm("CzyscHistorie", "Wynajmy", FormMethod.Post, new { style = "margin: 0;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="my-custom-btn fw-bold" onclick="return confirm('Czy na pewno chcesz zarchiwizować i przenieść do archiwum wpisy starsze niż dzisiaj?');">
                <i class="glyphicon glyphicon-trash"></i> Uruchom archiwizację bazy (starsze niż dzisiaj)
            </button>
        }
    </div>

</div>

<table class="table table-striped table-hover w-100" style="table-layout: auto;">
    <thead class="table-dark">
        <tr>
            <th>Klient (Imię i Nazwisko)</th>
            <th>Nazwa sprzętu</th>
            <th>Data wynajmu</th>
            <th>Planowany zwrot</th>

            <th style="width: 1%; white-space: nowrap; padding-left: 12px;" class="text-start">Akcje</th>
        </tr>
    </thead>

    @if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Admin"))
        {
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Klient.Imie @item.Klient.Nazwisko</td>
                        <td>[@item.Sprzets.NumerSeryjny] @item.Sprzets.Nazwa</td>
                        <td>@item.DataWynajmu.ToShortDateString()</td>
                        <td>@(item.DataZwrotu.HasValue ? item.DataZwrotu.Value.ToShortDateString() : "Brak danych")</td>

                        <td style="white-space: nowrap; padding-left: 12px;" class="text-start">
                            @Html.ActionLink("Drukuj PDF", "DrukujPdf", new { id = item.Id }, new { @class = "btn btn-danger btn-sm", style = "margin-right: 5px;" })

                            @using (Html.BeginForm("Delete", "Wynajmy", new { id = item.Id }, FormMethod.Post, new { onsubmit = "return confirm('Czy na pewno chcesz usunąć ten wynajem i zwrócić sprzęt do magazynu?');", style = "display:inline; margin: 0; padding: 0;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Usuń wynajem</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Klient.Imie @item.Klient.Nazwisko</td>
                        <td>[@item.Sprzets.NumerSeryjny] @item.Sprzets.Nazwa</td>
                        <td>@item.DataWynajmu.ToShortDateString()</td>
                        <td>@(item.DataZwrotu.HasValue ? item.DataZwrotu.Value.ToShortDateString() : "Brak danych")</td>
                        <td style="white-space: nowrap; padding-left: 12px;" class="text-start">
                            @Html.ActionLink("Drukuj PDF", "DrukujPdf", new { id = item.Id }, new { @class = "btn btn-danger btn-sm", style = "margin-right: 5px;" })
                        </td>
                    </tr>
                }
            </tbody>
        }
    }
</table>