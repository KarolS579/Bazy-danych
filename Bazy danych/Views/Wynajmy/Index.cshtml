@using (Html.BeginForm("CzyscHistorie", "Wynajmy", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div style="margin: 15px 0;">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Czy na pewno chcesz zarchiwizować i przenieść do archiwum wpisy starsze niż rok?');">
            <i class="glyphicon glyphicon-trash"></i> Uruchom archiwizację bazy (starsze niż rok)
        </button>
    </div>
}
@Html.ActionLink("Zobacz Archiwum", "Archiwum", null, new { @class = "btn btn-info" })
@model IEnumerable<Bazy_danych.Models.Wynajem>

@{
    ViewBag.Title = "Lista Wynajmów";
}

<h2>Panel Wynajmów</h2>

<p>
    @Html.ActionLink("Dodaj nowy wynajem", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Klient (Imię i Nazwisko)</th>
            <th>Nazwa sprzętu</th>
            <th>Data wynajmu</th>
            <th>Planowany zwrot</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Klient.Imie @item.Klient.Nazwisko</td>
                <td>@item.Sprzets.Nazwa</td>
                <td>@item.DataWynajmu.ToShortDateString()</td>
                <td>@(item.DataZwrotu.HasValue ? item.DataZwrotu.Value.ToShortDateString() : "Brak danych")</td>
                <td>
                    @using (Html.BeginForm("Delete", "Wynajmy", new { id = item.Id }, FormMethod.Post, new { onsubmit = "return confirm('Czy na pewno chcesz usunąć ten wynajem i zwrócić sprzęt do magazynu?');", style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Usuń wynajem</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>