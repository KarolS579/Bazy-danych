@* encoding: utf-8 *@
@model IEnumerable<Bazy_danych.Models.Klient>

@{
    ViewBag.Title = "Klienci";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Klienci</h2>
        <a class="my-custom-btn fw-bold" href="@Url.Action("Create", "Klienci")">+ Dodaj klienta</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Imię</th>
                                <th>Nazwisko</th>
                                <th>Telefon</th>
                                <th>Email</th>
                                <th>Firma</th>
                                <th>Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Imie</td>
                                    <td>@item.Nazwisko</td>
                                    <td>@item.Telefon</td>
                                    <td>@item.Email</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Firma))
                                        {
                                            @item.Firma
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Brak</span>
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", "Klienci", new { id = item.Id })">Edytuj</a>

                                        @using (Html.BeginForm("DeleteKlienci", "Klienci", FormMethod.Post, new { @class = "delete-client-form", @style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                        }
                                    </td>

                                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3 fw-bold" })

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Brak klientów w bazie.
                    Kliknij <strong>+ Dodaj klienta</strong>, aby dodać pierwszy wpis.
                </div>
            }
        </div>
    </div>
</div>
<script>
    document.querySelectorAll('.delete-client-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            // 1. Zatrzymujemy standardowe przeładowanie strony
            e.preventDefault();

            // 2. Standardowe pytania potwierdzające użytkownika
            if (!confirm('Czy na pewno chcesz usunąć tego klienta?')) {
                return;
            }

            const formData = new FormData(this);

            // 3. Wysyłanie żądania w tle (AJAX)
            fetch(this.action, {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Jeśli usunięto pomyślnie -> odświeżamy stronę, aby klient zniknął z listy
                        window.location.reload();
                    } else {
                        // JEŚLI JEST BŁĄD (Klient ma wynajmy) -> WYŚWIETLAMY ALERT WINDOW
                        alert(data.message);
                    }
                })
                .catch(error => {
                    alert('Wystąpił nieoczekiwany błąd komunikacji.');
                });
        });
    });
</script>