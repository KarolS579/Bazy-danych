@model IEnumerable<Bazy_danych.Models.Serwis>

@{
    ViewBag.Title = "Rejestr Serwisowy";
}

<h2>Zgłoszenia Serwisowe maszyn</h2>

<p>
    @Html.ActionLink("Dodaj sprzęt do serwisu", "Create", null, new { @class = "btn btn-danger" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Maszyna / Sprzęt</th>
            <th>Opis awarii / naprawy</th>
            <th>Data przyjęcia</th>
            <th>Koszt</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sprzet.Nazwa</td>
                <td>@item.OpisUsterki</td>
                <td>@item.DataZgloszenia.ToShortDateString()</td>
                <td>@(item.Koszt.HasValue ? item.Koszt.Value.ToString("C") : "Do wyceny")</td>
                <td>
                    @if (item.Status == "Naprawiono")
                    {
                        <span class="label label-success">@item.Status</span>
                    }
                    else
                    {
                        <span class="label label-danger">@item.Status</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>