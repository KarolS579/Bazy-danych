@model List<Bazy_danych.Models.Sprzet>
@{
    ViewBag.Title = "Porównywarka sprzętu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-arrow-left-right text-success"></i> Zestawienie porównawcze sprzętu</h2>
        <a href="@Url.Action("Results", "Search")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Powrót do wyszukiwarki</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="bi bi-info-circle-fill"></i> Nie dodałeś jeszcze żadnego sprzętu do porównania. Wróć do wyszukiwarki i kliknij zielony przycisk "Dodaj" przy dostępnych urządzeniach.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-light">
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0" style="table-layout: fixed;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 200px;" class="text-start bg-secondary text-white">Parametr</th>
                            @foreach (var item in Model)
                            {
                                <th>@item.Nazwa</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start fw-bold bg-light">Kod / Nr Seryjny</td>
                            @foreach (var item in Model)
                            {
                                <td><code class="text-dark fw-bold bg-white p-1 rounded border">@item.NumerSeryjny</code></td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold bg-light">Kategoria</td>
                            @foreach (var item in Model)
                            {
                                <td><span class="badge bg-secondary p-2">@item.Kategoria</span></td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold bg-light">Koszt dobowy wynajmu</td>
                            @foreach (var item in Model)
                            {
                                <td class="fs-5 fw-bold text-success">@item.Cena_wynajmu.ToString("C")</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold bg-light">Aktualna lokalizacja</td>
                            @foreach (var item in Model)
                            {
                                <td><i class="bi bi-geo-alt-fill text-danger"></i> @(item.Magazyn != null ? item.Magazyn.Nazwa : "Brak")</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold bg-light">Data rejestracji</td>
                            @foreach (var item in Model)
                            {
                                <td>@item.CreatedDate.ToShortDateString()</td>
                            }
                        </tr>
                        <tr class="table-footer">
                            <td class="text-start fw-bold bg-light">Zarządzaj</td>
                            @foreach (var item in Model)
                            {
                                <td>
                                    <button type="button" class="btn btn-sm btn-danger btn-remove-compare" data-id="@item.Id">
                                        <i class="bi bi-trash"></i> Usuń z listy
                                    </button>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('.btn-remove-compare').on('click', function (e) {
                e.preventDefault();
                var button = $(this);
                var id = button.data('id');

                // Znajdujemy indeks kolumny w tabeli, aby usunąć ją w całości
                var columnIndex = button.closest('td').index();

                $.ajax({
                    url: '@Url.Action("UsunZPorownania", "Search")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            // Jeśli w porównywarce nie ma już żadnego sprzętu, odświeżamy stronę, by pokazać komunikat o pustej liście
                            if (response.count === 0) {
                                location.reload();
                            } else {
                                // Usuwamy nagłówek (th) oraz wszystkie komórki (td) z danej kolumny
                                $('table tr').each(function() {
                                    $(this).find('td, th').eq(columnIndex).remove();
                                });
                            }
                        }
                    }
                });
            });
        });
    </script>
}