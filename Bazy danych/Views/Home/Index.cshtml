@* encoding: utf-8 *@
@{
    ViewBag.Title = "Strona główna";
}

<div class="container mt-5">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-4 fw-bold mb-3">Witaj w BuildRent</h1>
            <p class="lead text-muted mb-4">Zarządzaj wynajmem i rezerwacją sprzętu budowlanego w jednym miejscu</p>
            <a href="@Url.Action("Equipment", "Home")" class="btn btn-warning btn-lg fw-bold">Przeglądaj Sprzęt</a>
        </div>
    </div>

    <!-- Quick Stats Section -->
    <div class="row mb-5">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="display-6 fw-bold text-warning">1,250</h3>
                    <p class="text-muted">Dostępne urządzenia</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="display-6 fw-bold text-success">850</h3>
                    <p class="text-muted">Wynajęte</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="display-6 fw-bold text-info">45</h3>
                    <p class="text-muted">W serwisie</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="display-6 fw-bold text-primary">380</h3>
                    <p class="text-muted">Klienci aktywni</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Cards Section -->
    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 hover-card" style="cursor: pointer;">
                <a href="@Url.Action("Equipment", "Home")" style="text-decoration: none; color: inherit;">
                    <div class="card-body text-center">
                        <div class="fs-1 mb-3">🏗️</div>
                        <h5 class="card-title fw-bold">Sprzęt</h5>
                        <p class="card-text text-muted">Zarządzaj inwentarzem sprzętu budowlanego i jego dostępnością</p>
                        <span class="badge bg-warning text-dark">17 kategorii</span>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 hover-card" style="cursor: pointer;">
                <a href="@Url.Action("Warehouses", "Home")" style="text-decoration: none; color: inherit;">
                    <div class="card-body text-center">
                        <div class="fs-1 mb-3">📦</div>
                        <h5 class="card-title fw-bold">Magazyny</h5>
                        <p class="card-text text-muted">Monitoruj lokalizację i stan sprzętu w magazynach</p>
                        <span class="badge bg-info">12 lokalizacji</span>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 hover-card" style="cursor: pointer;">
                <a href="@Url.Action("Customers", "Home")" style="text-decoration: none; color: inherit;">
                    <div class="card-body text-center">
                        <div class="fs-1 mb-3">👥</div>
                        <h5 class="card-title fw-bold">Klienci</h5>
                        <p class="card-text text-muted">Zarządzaj bazą klientów i ich historią wynajmów</p>
                        <span class="badge bg-success">380 klientów</span>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 hover-card" style="cursor: pointer;">
                <a href="@Url.Action("Rentals", "Home")" style="text-decoration: none; color: inherit;">
                    <div class="card-body text-center">
                        <div class="fs-1 mb-3">📅</div>
                        <h5 class="card-title fw-bold">Wynajem i Rezerwacje</h5>
                        <p class="card-text text-muted">Zarządzaj wynajmami, rezerwacjami i umowami</p>
                        <span class="badge bg-primary">850 aktywnych</span>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 hover-card" style="cursor: pointer;">
                <a href="@Url.Action("Services", "Home")" style="text-decoration: none; color: inherit;">
                    <div class="card-body text-center">
                        <div class="fs-1 mb-3">🔧</div>
                        <h5 class="card-title fw-bold">Serwis</h5>
                        <p class="card-text text-muted">Śledź konserwację i naprawy sprzętu</p>
                        <span class="badge bg-danger">45 w trakcie</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: box-shadow 0.3s ease;
    }
    
    .hover-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .hover-card a {
        text-decoration: none !important;
    }
</style></style>