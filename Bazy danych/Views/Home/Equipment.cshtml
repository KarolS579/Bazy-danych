@* encoding: utf-8 *@
@model IEnumerable<Bazy_danych.Models.Sprzet>

@{
    ViewBag.Title = "Zarządzanie Sprzętem";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inwentarz Sprzętu</h2>
        <button class="btn btn-warning fw-bold">+ Dodaj nowy sprzęt</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nazwa</th>
                        <th>Kategoria</th>
                        <th>Cena (PLN/doba)</th>
                        <th>Status</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Koparka Gąsienicowa CAT 320</td>
                        <td>Maszyny ciężkie</td>
                        <td>800,00</td>
                        <td><span class="badge bg-success">Dostępny</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary">Wynajmij</button>
                            <button class="btn btn-sm btn-outline-secondary">Szczegóły</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Ładowarka Kołowa Volvo L120H</td>
                        <td>Ładowarki</td>
                        <td>550,00</td>
                        <td><span class="badge bg-danger">Wynajęty</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-info">Historia</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Zagęszczarka Belle PCX</td>
                        <td>Drogowe</td>
                        <td>120,00</td>
                        <td><span class="badge bg-info text-dark">Serwis</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning">Zakończ serwis</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>