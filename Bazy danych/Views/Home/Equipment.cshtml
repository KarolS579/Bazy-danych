@* encoding: utf-8 *@
@model IEnumerable<Bazy_danych.Models.Sprzet>

@{
    ViewBag.Title = "Zarządzanie Sprzętem";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inwentarz Sprzętu</h2>
        <a class="btn btn-warning fw-bold" href="@Url.Action("AddEquipment", "Home")">+ Dodaj nowy sprzęt</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nazwa</th>
                            <th>Kategoria</th>
                            <th>Cena (PLN/doba)</th>
                            <th>Status</th>
                            <th>Data dodania</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nazwa</td>
                                <td>@item.Kategoria</td>
                                <td>@item.Cena_wynajmu.ToString("0.00")</td>
                                <td>
                                    @if (item.Status == "Dostępny")
                                    {
                                        <span class="badge bg-success">Dostępny</span>
                                    }
                                    else if (item.Status == "Wynajęty")
                                    {
                                        <span class="badge bg-danger">Wynajęty</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Serwis</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditEquipment", "Home", new { id = item.Id })">Edytuj</a>
                                    @using (Html.BeginForm("DeleteEquipment", "Home", FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno chcesz usunąć ten sprzęt?');">Usuń</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Brak sprzętu w bazie. Kliknij <strong>+ Dodaj nowy sprzęt</strong>, aby dodać pierwszy wpis.
                </div>
            }
        </div>
    </div>
</div>