@{
    ViewBag.Title = "Panel Klienta";
}

<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-4 shadow-sm border border-light">
        <div class="container-fluid py-2">
            <span class="badge bg-success mb-2 px-3 py-2 rounded-pill fw-bold text-uppercase">Strefa Klienta</span>
            <h1 class="display-5 fw-bold text-dark">Witaj ponownie!</h1>
            <p class="col-md-8 fs-5 text-muted">Zalogowano jako: <strong>@ViewBag.UserEmail</strong>. Zarządzaj swoimi rezerwacjami, przeglądaj dostępny sprzęt i zamawiaj urządzenia online.</p>
            <a href="@Url.Action("Index", "UserEquipment")" class="btn btn-success btn-lg fw-bold px-4 rounded-3 shadow-sm">
                <i class="bi bi-search me-2"></i> Przeglądaj katalog ofertowy
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white hover-shadow transition">
                <div class="card-body">
                    <div class="mb-3 text-success">
                        <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="h4 fw-bold card-title mb-2">Wynajmij Sprzęt</h3>
                    <p class="text-muted small">Przejrzyj listę urządzeń dostępnych od ręki w naszych magazynach.</p>
                    <a href="@Url.Action("Index", "UserEquipment")" class="btn btn-sm btn-outline-success rounded-pill px-4 mt-2">Otwórz katalog</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white hover-shadow transition">
                <div class="card-body">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-file-earmark-check" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="h4 fw-bold card-title mb-2">Moje Umowy</h3>
                    <p class="text-muted small">Przejrzyj listę wynajmów akywnych na naszej stronie</p>
                    <a href="@Url.Action("Index", "Wynajmy")" class="btn btn-sm btn-outline-primary rounded-pill px-4 mt-2">Zobacz historię</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white hover-shadow transition">
                <div class="card-body">
                    <div class="mb-3 text-secondary">
                        <i class="bi bi-headset" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="h4 fw-bold card-title mb-2">Pomoc i Kontakt</h3>
                    <p class="text-muted small">Potrzebujesz wsparcia technicznego lub chcesz zgłosić awarię sprzętu?</p>
                    <a href="@Url.Action("Contact", "Home")" class="btn btn-sm btn-outline-secondary rounded-pill px-4 mt-2">Skontaktuj się</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Opcjonalny, lekki efekt wizualny dla kafelków */
    .hover-shadow {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
        }
</style>